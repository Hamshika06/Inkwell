    "First Party Collection/Use": "Data Collection & Use",
    "Third Party Sharing/Collection": "Data Sharing",
    "User Choice/Control": "User Rights & Choices",
    "User Access, Edit and Deletion": "User Rights & Choices",
    "Do Not Track": "User Rights & Choices",
    "Data Security": "Data Security & Retention",
    "Data Retention": "Data Security & Retention",
    "Policy Change": "Policy Scope & Changes",
    "International and Specific Audiences": "Policy Scope & Changes",
    "Other": null
  }
}
