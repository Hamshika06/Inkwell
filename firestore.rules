rules_version = '2';
// Inkwell: each person can read and write only their own priorities and saved policies.
// Email/password accounts must have confirmed their address (Google and GitHub accounts pass).
// Saved policies hold a name, verdicts, choice, ticked steps and a text fingerprint; never policy text.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && (request.auth.token.firebase.sign_in_provider != 'password' || request.auth.token.email_verified == true);
    }

    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['priorities'])
        && request.resource.data.priorities is list && request.resource.data.priorities.size() <= 8;

      match /policies/{policyId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && policyId.size() <= 60
          && request.resource.data.keys().hasOnly(['name', 'url', 'checkedAt', 'savedAt', 'fingerprint', 'verdicts',
                                                    'decision', 'done', 'stepsTotal', 'previous'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 500));
      }
    }
  }
}
